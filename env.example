# Переименуйте этот файл в .env и впишите свои значения

# Telegram API: https://my.telegram.org, раздел "API development tools".
# Заполните форму (название приложения любое), получите api_id и api_hash.
TG_API_ID=12345678
TG_API_HASH=0123456789abcdef0123456789abcdef

# DeepSeek: https://platform.deepseek.com, раздел API Keys.
# Пополните баланс на пару долларов, хватит на месяцы работы.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
